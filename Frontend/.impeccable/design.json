    }
  ],
  "narrative": {
    "northStar": "Mud & Doors",
    "overview": "The console is a Najdi house in Qassim. Limewashed walls are the calm ground; colour lives only on the painted wooden doors, and every door is something you can open: your turn, a request, a team's inbox, a day on the calendar. Triangular tarma openings mark progress, the stepped shurfa parapet tops the header, and the booking calendar is a course of bricks in mortar.",
    "keyCharacteristics": [
      "Colour is state: green done, ochre waiting on you, madder returned, indigo with a team, umber draft, neutral none",
      "One painted Door per region",
      "Rows on the wall, not card grids",
      "Reem Kufi titles, Thmanyah Sans UI",
      "Phone first, Arabic first, night-adobe dark mode"
    ],
    "rules": [
      {
        "name": "Colour is state",
        "body": "Every colour answers 'which state is this?' with a door tone or neutral; status tones live only in status-badge.tsx.",
        "section": "colors"
      },
      {
        "name": "Rank by weight",
        "body": "Tight scale; section heads are 16px bold over a one-pixel ink rule.",
        "section": "typography"
      },
      {
        "name": "Paint, not bevels",
        "body": "Plates are flat paint with a hairline; only a Door casts a resting shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use Plate, Tarma, Door, SectionHead, StatePill from components/najdi.tsx and status-badge.tsx",
      "Do wrap user content in <bdi> and format dates with lib/format.ts",
      "Do check phone and desktop, ar and en, light and dark with tests/ui-preview"
    ],
    "donts": [
      "Don't use brand-* classes or round status dots",
      "Don't build grids of same-size cards or rows of big-number tiles",
      "Don't use Reem Kufi for labels, buttons or data",
      "Don't propose a new look: extend this one"
    ]
  }
}
