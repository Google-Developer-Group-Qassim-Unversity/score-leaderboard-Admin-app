    {
      "name": "Everyday button",
      "kind": "button",
      "refersTo": "button-default",
      "description": "Mud ink. Save, create, the ordinary action.",
      "html": "<button class=\"ds-btn\">Save</button>",
      "css": ".ds-btn{background:var(--primary,#3a2a1f);color:var(--primary-foreground,#f8f3ea);height:44px;padding:0 16px;border:0;border-radius:4px;font:700 14px 'Thmanyah Sans',Tajawal,sans-serif;cursor:pointer;transition:background-color .15s,transform .15s}.ds-btn:hover{background:color-mix(in srgb,var(--primary,#3a2a1f) 88%,transparent)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid var(--ring,#2b4a7e);outline-offset:2px}"
    },
    {
      "name": "Ochre door button",
      "kind": "button",
      "refersTo": "button-ochre",
      "description": "The action waiting on the reader: Book dates, Continue.",
      "html": "<button class=\"ds-btn-ochre\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M16 2v4M8 2v4M3 10h18\"/></svg>Book dates</button>",
      "css": ".ds-btn-ochre{display:inline-flex;align-items:center;gap:8px;background:var(--door-ochre,#d39a1c);color:var(--on-door-ochre,#2b1c0c);height:44px;padding:0 16px;border:0;border-radius:4px;box-shadow:inset 0 0 0 1px rgb(0 0 0/.08),inset 0 -2px 0 rgb(0 0 0/.08);font:700 14px 'Thmanyah Sans',Tajawal,sans-serif;cursor:pointer}.ds-btn-ochre:hover{filter:brightness(1.05)}.ds-btn-ochre:active{transform:translateY(1px)}.ds-btn-ochre:focus-visible{outline:2px solid var(--ring,#2b4a7e);outline-offset:2px}"
